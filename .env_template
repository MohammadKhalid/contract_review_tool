# Database Configuration
# Copy this file to .env and fill in your actual values

POSTGRES_DB=contract_db
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_secure_password

# Application Environment
ENV=development

# xAI (Grok) Configuration for LLM Judge
# Get your API key from https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-beta

# === Admin Authentication + Polar.sh Paywall ===
# ADMIN_API_KEY: Static secret for full backend access (bypasses Polar). Use for tests, seeding, internal tools.
ADMIN_API_KEY=change-this-to-a-long-random-string-for-admin-access

# Polar.sh (https://polar.sh) — one-time purchase + License Key benefit for the paywall
# 1. Create account + organization at polar.sh
# 2. Create a one-time Product (e.g. "Contract Analysis Access Pass")
# 3. Add a "License Key" benefit to the product (configure expiry or usage limit if desired)
# 4. Create an Organization Access Token (OAT) in org settings
# 5. Copy the values below. Start with sandbox for testing.
#
# Required for dynamic checkout creation in the "Buy Access Pass" flow
POLAR_ANALYSIS_PRODUCT_ID=your-product-id-here

POLAR_ACCESS_TOKEN=polar_pat_your_token_here
POLAR_ORGANIZATION_ID=your-org-uuid-here
POLAR_SERVER=sandbox

# Required for the official Polar webhook handler (highly recommended)
# Create this in Polar Dashboard → Settings → Webhooks
POLAR_WEBHOOK_SECRET=whsec_...

# After setup: run the app, buy via the embedded checkout in the UI (test cards in sandbox),
# then the license key is automatically delivered and used for /contracts/analyze calls.

# CORS (for production, restrict this!)
# For List[str] fields pydantic-settings expects a JSON array in the env var.
# Always use this format:
CORS_ORIGINS='["*"]'
CORS_METHODS='["*"]'
CORS_HEADERS='["*"]'
# ALLOWED_EXTENSIONS='[".pdf"]'
# For production:
# CORS_ORIGINS='["https://yourdomain.com"]'
